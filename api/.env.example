DATABASE_URL=postgres://postgres:postgres@localhost:5432/elecsense
PORT=3000
NODE_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Shared token required on state-changing requests (telemetry ingestion,
# incident actions, simulator injection). Leave empty to allow them
# unauthenticated; the API logs a warning at boot when it is unset.
# Sent as `Authorization: Bearer <token>` or `x-operator-token: <token>`.
OPERATOR_TOKEN=

# Extra allowed browser origins, comma separated. Vercel deployments of this
# project and localhost are already allowed without listing them here.
CORS_ORIGINS=

# Detection loop. Interval is in milliseconds; set DETECTION_LOOP_DISABLED=true
# to run the API without background fault detection (used by the test suite).
DETECTION_LOOP_INTERVAL_MS=10000
DETECTION_LOOP_DISABLED=false
